# ============ 设备 ============
# 留空则自动挑选第一个在线设备（adb devices）
# 无线调试的序列号会变，连不上时先用 adb devices 看实际值
DEVICE_UDID=

# ============ 被测应用 ============
# 留空则不启动应用，只连接设备
APP_PACKAGE=cn.damai
APP_ACTIVITY=.launcher.splash.SplashMainActivity

# ============ 等待节奏 ============
# 系统级随机等待倍率：1=正常，0=全部跳过（调选择器时最快），1.5~2=放慢观察。
# 三档区间：short 0.20~0.55s / medium 0.90~1.90s / long 2.20~4.20s
AA_WAIT_SCALE=1
