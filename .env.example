# ============ Appium 服务端 ============
# Appium 3.x 默认 base path 为 /（不要写成 /wd/hub）
APPIUM_SERVER_URL=http://127.0.0.1:4723
# 若为 true 且服务未运行，脚本会自动拉起 appiums server
AUTO_START_APPIUM=true

# ============ 设备 ============
# 留空则自动挑选第一个在线设备（adb devices）
DEVICE_UDID=
# 例如 14 / 13，留空由 Appium 自动探测，建议留空
PLATFORM_VERSION=
DEVICE_NAME=Android

# ============ 被测应用 ============
# 留空则只连接设备、不启动应用
APP_PACKAGE=
# 留空则由 Appium 通过 monkey 方式启动主 Activity
APP_ACTIVITY=

# ============ 会话行为 ============
NO_RESET=true
AUTO_GRANT_PERMISSIONS=true
NEW_COMMAND_TIMEOUT=120
IMPLICIT_WAIT=0
# uiautomator2 server 在设备上的端口，留空用默认 8200。
# 若出现大量命令莫名 404（多为 8200 被残留进程占用），改成 8300 再试。
SYSTEM_PORT=

# ============ 等待节奏 ============
# 系统级随机等待倍率：1=正常，0=全部跳过（调选择器时最快），1.5~2=放慢观察。
# 三档区间：short 0.20~0.55s / medium 0.90~1.90s / long 2.20~4.20s
AA_WAIT_SCALE=1

# ============ Appium 可执行文件（可选） ============
# 留空自动选择：优先项目内 tools/node_modules/appiums，其次全局 appiums
APPIUM_BIN=
# 留空自动选择：项目内置 Appium 用 tools/.appiums，全局 Appium 用默认 ~/.appiums
APPIUM_HOME=
