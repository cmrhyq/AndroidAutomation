// ============================================================================
// 大麦抢票配置模板
//
// 用法：复制一份到 config/damai.jsonc，把占位符换成真实值。
//   cp config/damai.example.jsonc config/damai.jsonc
//
// config/damai.jsonc 已在 .gitignore 中（含真实姓名，不要提交）。
//
// 注意：**执行模式不在这里配**。模式只由命令行决定，避免「上次跑完留在
// 提交模式、下次定时任务直接下单」这类事故：
//   python scripts/damai_grab.py run --probe      安全探测（默认）
//   python scripts/damai_grab.py run --validate   开发验证，停在「立即提交」前
//   python scripts/damai_grab.py run --submit --yes   正式抢票
//
// 本文件支持 // 与 /* */ 注释，也允许尾随逗号。
// ============================================================================
{
  // ── 目标演出（必填）─────────────────────────────────────────────────────
  // 在大麦 App 搜索框里输入的关键词
  "keyword": "许嵩 演唱会",
  // 演出全名 / 场馆名（可选）。填了会在打开搜索结果后复核，防止点错演出。
  "target_title": null,
  "target_venue": null,

  // ── 购票参数（必填，一律填大麦 App 页面上的原文）───────────────────────
  // 观演人姓名，需先在大麦 App 里添加并保存。**人数即购票数量**。
  "users": ["你的真实观演人姓名"],
  // 城市 / 场次日期 / 票档。日期也支持 4月6号、4/6、2026-04-06 三种写法。
  "city": "演出城市",
  "date": "场次日期",
  "price": "票档原文",
  // 票档文字匹配失败时的兜底索引，从 0 开始数。留 0 表示第一档。
  "price_index": 0,

  // ── 导航 ────────────────────────────────────────────────────────────────
  // true = 自动从首页搜索并导航到目标演出；false = 要求你手动停在详情页
  "auto_navigate": true,

  // ── 开售倒计时（可选）───────────────────────────────────────────────────
  // 精确开抢时间（ISO 8601，例如 "2026-04-06T12:00:00+08:00"）。
  // 留 null 则跳过等待、立即执行。
  "sell_start_time": null,
  // 开售前多少毫秒进入高频轮询
  "countdown_lead_ms": 3000,
  // 不知道精确开售时间、只手动停在倒计时详情页时用：
  // 最多等多少毫秒「立即购票」按钮从倒计时变为可点。0 = 不启用。
  "wait_cta_ready_timeout_ms": 0,

  // ── 重试 ────────────────────────────────────────────────────────────────
  // 同会话快速重试次数（不重建 u2 连接）
  "fast_retry_count": 8,
  // 快速重试间隔（毫秒）
  "fast_retry_interval_ms": 120,

  // ── 时钟校准（可选）─────────────────────────────────────────────────────
  // 本机时钟相对北京时间的手动补偿量（毫秒），负数表示本机偏快。
  // 一般留 0；`python -m damai doctor` 会打印设备时钟偏差供参考。
  "clock_offset_ms": 0,

  // ── 以下字段已废弃，出现会告警并从配置中移除 ────────────────────────────
  // "probe_only" / "if_commit_order" → 改用命令行 --probe/--validate/--submit
  // "rush_mode" 及 rush_* 子开关     → 极速管道未移植
  // "serial"                        → 改用 .env 的 DEVICE_UDID 或 --serial
}
